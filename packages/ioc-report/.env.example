# Copy to .env (git-ignored, mode 0600). Process environment values take precedence.
# A commented line shows a setting's default; uncomment it only to change it.

# The source tables triage's `load-zeek` writes, opened read-only.
NETWORK_BEHAVIOUR_SOURCE_PATH=../triage/data/source.duckdb
# NETWORK_BEHAVIOUR_SOURCE_QUERY_TIMEOUT=900
# Detail retention in days, as the original probe had (about 15). Empty: kept while loaded.
# NETWORK_BEHAVIOUR_SOURCE_DETAIL_DAYS=
# The triage store this report reads, read-only.
NETWORK_BEHAVIOUR_DUCKDB_PATH=../triage/data/network_behaviour.duckdb
# ioc-match: an ip2asn-format TSV (iptoasn.com's ip2asn-v4.tsv) for network names and countries.
# NETWORK_BEHAVIOUR_ASN_TABLE=
# Demo and tests only: documentation ranges count as public and .test as a public suffix.
# NETWORK_BEHAVIOUR_SYNTHETIC=
# The indicators' first and last seen dates, which ioc-match writes and ioc-report reads.
# IOC_METADATA_PATH=data/ioc_metadata.json

# The writer and the verdict model: ollama (local) or openrouter (external, needs --budget).
# MODEL_PROVIDER=ollama
# Empty: MODEL_PROVIDER.
# SHADOW_PROVIDER=
# The local writer. OLLAMA_URL must be a loopback address.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_NUM_CTX=8192
# Sent as Ollama's think option when set: a thinking model needs false to answer in JSON.
# OLLAMA_THINK=

# Only for opt-in external runs (MODEL_PROVIDER/SHADOW_PROVIDER=openrouter, case reports).
OPENROUTER_API_KEY=
# Required for MODEL_PROVIDER/SHADOW_PROVIDER=openrouter; case reports default to
# anthropic/claude-haiku-5.5.
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# low, medium or high.
# OPENROUTER_EFFORT=medium
# OPENROUTER_MAX_TOKENS=8000

# rdap: send registered domains, and nothing else, to RDAP servers for the E3 name check.
# NAME_LOOKUP=
# RDAP_CACHE_DIR=data/rdap

# Optional: an IANA zone whose clock the reports show beside UTC (e.g. Europe/Berlin). Empty: UTC only.
REPORT_TIMEZONE=
