# Copy to .env (git-ignored, mode 0600). Process environment values take precedence.
# The source tables: a DuckDB file `network-behaviour load-zeek` writes and every reader opens read-only.
NETWORK_BEHAVIOUR_SOURCE_PATH=data/source.duckdb
NETWORK_BEHAVIOUR_SOURCE_QUERY_TIMEOUT=900
# Detail retention in days, as the original probe had (about 15). Empty: kept while loaded.
NETWORK_BEHAVIOUR_SOURCE_DETAIL_DAYS=
# Detail retention in days, as the original probe had (about 15). Empty: kept while loaded.
NETWORK_BEHAVIOUR_SOURCE_DETAIL_DAYS=
# The local side of every connection. Empty: Zeek's local_orig/local_resp decide.
NETWORK_BEHAVIOUR_LOCAL_NETS=10.0.0.0/8
# Optional ip2asn-format TSV (iptoasn.com's ip2asn-v4.tsv) for server ASNs.
NETWORK_BEHAVIOUR_ASN_TABLE=
# Demo and tests only: documentation ranges count as public and .test as a public suffix.
NETWORK_BEHAVIOUR_SYNTHETIC=
NETWORK_BEHAVIOUR_SQL_DIR=sql/source
NETWORK_BEHAVIOUR_DUCKDB_PATH=data/network_behaviour.duckdb
NETWORK_BEHAVIOUR_MIGRATION_DIR=sql/migrations
NETWORK_BEHAVIOUR_RUN_DIR=data/runs
NETWORK_BEHAVIOUR_STORAGE_ALERT_GIB=40
NETWORK_BEHAVIOUR_STORAGE_STOP_GIB=45
NETWORK_BEHAVIOUR_LOCK_PATH=data/network_behaviour.duckdb.lock
