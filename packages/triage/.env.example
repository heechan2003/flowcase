# Copy to .env (git-ignored, mode 0600). Process environment values take precedence.
# The ClickHouse block is replaced by the Zeek source in milestone 3 and holds no values.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false
CLICKHOUSE_READONLY=true
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=300
CLICKHOUSE_QUERY_TIMEOUT=900
NETWORK_BEHAVIOUR_SQL_DIR=sql/clickhouse
NETWORK_BEHAVIOUR_DUCKDB_PATH=data/network_behaviour.duckdb
NETWORK_BEHAVIOUR_MIGRATION_DIR=sql/migrations
NETWORK_BEHAVIOUR_RUN_DIR=data/runs
NETWORK_BEHAVIOUR_STORAGE_ALERT_GIB=40
NETWORK_BEHAVIOUR_STORAGE_STOP_GIB=45
NETWORK_BEHAVIOUR_LOCK_PATH=data/network_behaviour.duckdb.lock
